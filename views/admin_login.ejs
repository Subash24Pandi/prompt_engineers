<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #05070a; color: #ffffff; }
        .premium-card { background: #0c0e12; border: 1px solid rgba(255,255,255,0.05); }
        .premium-btn { background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); box-shadow: 0 4px 15px rgba(59, 130, 246, 0.4); transition: 0.3s; }
        .premium-btn:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(59, 130, 246, 0.6); }
    </style>
    <title>The AItel | Admin Login</title>
</head>
<body class="flex items-center justify-center min-h-screen p-4">
    <div class="premium-card p-8 rounded-[2rem] w-full max-w-sm text-center shadow-2xl">
        <img src="/logo.png" class="w-16 h-16 mx-auto mb-6 object-contain" onerror="this.src='https://via.placeholder.com/64?text=LOGO'">
        <h2 class="text-white text-2xl font-extrabold mb-8 tracking-widest uppercase">Admin Portal</h2>
        <div class="flex flex-col gap-6 w-full">
            <a href="/admin-login" class="premium-btn w-full text-white py-4 rounded-2xl font-bold text-base tracking-widest uppercase">Login as Admin</a>
            <a href="/create-admin" class="premium-btn w-full text-white py-4 rounded-2xl font-bold text-base tracking-widest uppercase">Register Admin</a>
            <a href="/admin-dashboard" class="premium-btn w-full text-white py-4 rounded-2xl font-bold text-base tracking-widest uppercase">Admin Dashboard</a>
        </div>
    </div>
</body>
</html>
