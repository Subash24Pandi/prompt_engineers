<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #05070a; color: #ffffff; }
        .premium-card { background: #0c0e12; border: 1px solid rgba(255,255,255,0.05); }
        .premium-btn { background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); box-shadow: 0 4px 15px rgba(59, 130, 246, 0.4); transition: 0.3s; }
        .premium-btn:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(59, 130, 246, 0.6); }
    </style>
    <title>The AItel | Engineer Agents</title>
</head>
<body class="min-h-screen">
    <header class="p-6 flex justify-between items-center max-w-6xl mx-auto">
        <img src="/logo.png" alt="Logo" class="w-24 h-24 object-contain" onerror="this.src='https://via.placeholder.com/96?text=LOGO'">
        <a href="/admin/dashboard" class="premium-btn px-6 py-2 rounded-lg text-[10px] font-black tracking-widest uppercase">← BACK TO DASHBOARD</a>
    </header>
    <main class="max-w-6xl mx-auto px-6 py-6">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <% agents.forEach(agent => { %>
                <a href="/admin/agent/<%= agent.id %>" class="premium-card p-8 rounded-[2rem] group relative hover:border-blue-500/50 transition-all duration-300 block">
                    <div class="w-12 h-12 bg-blue-500/10 rounded-xl flex items-center justify-center mb-6 group-hover:bg-blue-600 transition-all">
                        <svg class="w-6 h-6 text-blue-500 group-hover:text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                    </div>
                    <h3 class="text-xl font-bold tracking-tight mb-4 uppercase"><%= agent.agent_name %></h3>
                    <div class="flex flex-col gap-2">
                        <span class="text-xs text-gray-400">ID: <%= agent.id %></span>
                        <span class="text-xs text-gray-400">Created: <%= agent.created_at ? agent.created_at.toLocaleString() : '' %></span>
                    </div>
                </a>
            <% }) %>
        </div>
    </main>
</body>
</html>
