<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #05070a; color: #ffffff; }
        .premium-card { background: #0c0e12; border: 1px solid rgba(255,255,255,0.05); }
        .premium-btn { background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); box-shadow: 0 4px 15px rgba(59, 130, 246, 0.4); transition: 0.3s; }
        .premium-btn:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(59, 130, 246, 0.6); }
    </style>
    <title>The AItel | Admin Dashboard</title>
</head>
<body class="min-h-screen">
    <header class="p-6 flex items-center max-w-6xl mx-auto">
        <img src="/logo.png" alt="Logo" class="w-24 h-24 object-contain" onerror="this.src='https://via.placeholder.com/96?text=LOGO'">
    </header>
    <button class="premium-btn fixed top-6 right-6 px-6 py-2 rounded-lg text-[10px] font-black tracking-widest uppercase z-50" onclick="document.getElementById('adminModal').classList.remove('hidden')">CREATE ADMIN</button>
    <button class="premium-btn fixed bottom-6 right-6 px-6 py-2 rounded-lg text-[10px] font-black tracking-widest uppercase z-50" onclick="window.location='/logout'">LOGOUT</button>
    <main class="max-w-6xl mx-auto px-6 py-6">
        <h2 class="text-center text-white text-2xl font-extrabold mb-8 tracking-widest uppercase">Admin Dashboard</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <% engineers.forEach(function(engineer) { %>
                <div class="editor-box rounded-3xl p-8 shadow-xl flex flex-col items-center">
                    <div class="w-12 h-12 bg-blue-500/10 rounded-xl flex items-center justify-center mb-6">
                        <svg class="w-6 h-6 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                    </div>
                    <h3 class="font-bold text-lg tracking-widest mb-2 uppercase"><%= engineer.name %></h3>
                    <span class="text-xs text-gray-400 mb-2">ID: <%= engineer.id %></span>
                    <span class="text-xs text-gray-400 mb-2">Agents: <%= engineer.agent_count || 0 %></span>
                    <span class="text-xs text-gray-400 mb-4">Created: <%= engineer.created_at ? engineer.created_at.toLocaleString() : '' %></span>
                    <a href="/admin/engineer/<%= engineer.id %>" class="text-blue-500 font-bold text-xs uppercase hover:underline mb-2">Open Terminal →</a>
                    <form action="/admin/remove-engineer" method="POST" class="mt-2">
                        <input type="hidden" name="engineerId" value="<%= engineer.id %>">
                        <button class="text-red-500 text-[10px] font-bold uppercase hover:underline">Remove Engineer</button>
                    </form>
                </div>
            <% }) %>
        </div>
    </main>
    <!-- Admin Modal -->
    <div id="adminModal" class="hidden fixed inset-0 bg-black/80 z-50 flex items-center justify-center">
        <div class="premium-card p-8 rounded-[2rem] w-full max-w-sm text-center shadow-2xl relative">
            <button onclick="document.getElementById('adminModal').classList.add('hidden')" class="absolute top-4 right-4 text-white text-xl">&times;</button>
            <h2 class="text-white text-lg font-bold mb-6 tracking-widest uppercase">Create Admin</h2>
            <form action="/admin/create-admin" method="POST" class="space-y-4">
                <input type="text" name="username" placeholder="USERNAME" class="w-full bg-white/5 border border-white/10 p-3 rounded-xl text-white outline-none focus:border-blue-500 text-sm transition-all" required>
                <input type="text" name="name" placeholder="NAME" class="w-full bg-white/5 border border-white/10 p-3 rounded-xl text-white outline-none focus:border-blue-500 text-sm transition-all">
                <input type="password" name="password" placeholder="PASSWORD" class="w-full bg-white/5 border border-white/10 p-3 rounded-xl text-white outline-none focus:border-blue-500 text-sm transition-all" required>
                <button class="premium-btn w-full text-white py-3 rounded-xl font-bold text-xs tracking-widest uppercase">CREATE ADMIN</button>
            </form>
        </div>
    </div>
</body>
</html>
    </div>
</body>
</html>
