<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #05070a; color: #ffffff; }
        .premium-card { background: #0c0e12; border: 1px solid rgba(255,255,255,0.05); }
        .premium-btn { background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); box-shadow: 0 4px 15px rgba(59, 130, 246, 0.4); transition: 0.3s; }
        .premium-btn:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(59, 130, 246, 0.6); }
    </style>
    <title>Engineer Agents | Admin Portal</title>
</head>
<body style="background:#05070a; color:#fff; font-family:'Plus Jakarta Sans',sans-serif; min-height:100vh;">
    <header class="flex flex-col items-center justify-center p-6 max-w-6xl mx-auto">
        <img src="/logo.png" alt="Aitel Logo" class="w-24 mb-4">
        <h1 class="text-2xl font-bold mb-2">Engineer: <%= engineer.name %></h1>
        <a href="/admin-dashboard" class="bg-blue-500 text-white px-6 py-2 rounded-lg font-bold mt-2">Back</a>
    </header>
    <main class="max-w-6xl mx-auto px-6 py-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 justify-items-center">
            <% agents.forEach(agent => { %>
                    <div style="background:#05070a; border:1px solid rgba(255,255,255,0.05);" class="premium-card p-8 rounded-[2rem] w-96 flex flex-col items-center shadow-2xl">
                    <img src="/logo.png" alt="Aitel Logo" class="w-10 mb-2">
                    <h2 class="text-2xl font-bold mb-4 uppercase"><%= agent.agent_name %></h2>
                    <a href="/admin-dashboard/engineer/<%= engineer.id %>/agent/<%= agent.id %>" class="mt-2 text-[#2196f3] font-bold hover:underline">Open Terminal →</a>
                    <form action="/admin-dashboard/engineer/<%= engineer.id %>/agent/<%= agent.id %>/delete" method="POST" class="mt-2">
                        <button type="submit" class="text-red-500 text-xs font-bold uppercase hover:underline">Delete Agent</button>
                    </form>
                </div>
            <% }) %>
        </div>
    </main>
</body>
</html>
