<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <title>Prompt View | Admin Portal</title>
</head>
<body class="bg-gray-900 text-white min-h-screen">
    <header class="flex flex-col items-center justify-center p-6 max-w-6xl mx-auto">
        <img src="/logo.png" alt="Aitel Logo" class="w-24 mb-4">
        <h1 class="text-2xl font-bold mb-2">Prompt: <%= prompt.title %></h1>
        <a href="/admin-dashboard/engineer/<%= engineer.id %>/agent/<%= agent.id %>" class="bg-blue-500 text-white px-6 py-2 rounded-lg font-bold mt-2">Back</a>
    </header>
    <main class="max-w-6xl mx-auto px-6 py-6">
        <div class="bg-gray-800 rounded-2xl p-8 w-full max-w-5xl h-[90vh] flex flex-col items-center shadow-lg mx-auto">
            <img src="/logo.png" alt="Aitel Logo" class="w-12 mb-4">
            <div class="mb-4 w-full h-[75vh]">
                <label class="block font-bold mb-2">Prompt Content:</label>
                <div class="bg-gray-700 rounded p-4 whitespace-pre-wrap w-full h-full overflow-y-auto break-words" style="word-break:break-word;"> <%= prompt.content %> </div>
            </div>
            <!-- Reason and Date removed for full prompt view -->
        </div>
    </main>
</body>
</html>
