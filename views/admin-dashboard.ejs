<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;800&display=swap" rel="stylesheet">
    <style>
         body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #05070a; color: #ffffff; }
        .premium-card { background: #0c0e12; border: 1px solid rgba(255,255,255,0.05); }
        .premium-btn { background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); box-shadow: 0 4px 15px rgba(59, 130, 246, 0.4); transition: 0.3s; }
        .premium-btn:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(59, 130, 246, 0.6); }
    </style>
    <title>Admin Dashboard | Prompt Engineers Portal</title>
</head>
<body style="background:#05070a; color:#fff; font-family:'Plus Jakarta Sans',sans-serif; min-height:100vh;">
    <body style="background:#05070a; color:#fff; font-family:'Plus Jakarta Sans',sans-serif; min-height:100vh;">
        <div class="relative min-h-screen flex flex-col">
            <!-- Top bar with logo and Create Admin button at top right -->
            <div class="flex justify-between items-center px-10 pt-10">
        <img src="/logo.png" alt="Aitel Logo" class="w-20 h-20 object-contain" style="background:#05070a;">
                <a href="/create-admin" class="bg-blue-500 hover:bg-blue-600 text-white px-6 py-2 rounded-xl font-bold shadow transition-all">Create Admin</a>
            </div>
            <h1 class="text-2xl font-extrabold text-center mt-2 mb-8 tracking-widest uppercase">Admin Dashboard</h1>
            <main class="flex-1 max-w-6xl mx-auto px-6 py-6 w-full">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-12 justify-items-center">
                    <% engineers.forEach(engineer => { %>
                        <% if (
                            engineer.id_number &&
                                engineer.id_number !== 'founder@theaitel.com' && 
                                engineer.id_number !== 'co-founder@theaitel.com' && 
                                engineer.id_number !== 'Admin'
                        ) { %>
                        <div style="background:#05070a; border:1px solid rgba(255,255,255,0.05);" class="p-8 rounded-[2rem] w-96 flex flex-col items-center shadow-2xl">
                            <img src="/logo.png" alt="Aitel Logo" class="w-10 mb-2">
                            <h2 class="text-2xl font-bold mb-4 uppercase"><%= engineer.name %></h2>
                            <div class="text-sm text-gray-400 mb-2">ID: <%= engineer.id_number %></div>
                            <a href="/admin-dashboard/engineer/<%= engineer.id %>" class="mt-2 text-[#2196f3] font-bold hover:underline">Open Terminal →</a>
                            <form action="/admin-dashboard/engineer/<%= engineer.id %>/delete" method="POST" class="mt-2">
                                <button type="submit" class="text-red-500 text-xs font-bold uppercase hover:underline">Delete Engineer</button>
                            </form>
                        </div>
                        <% } %>
                    <% }) %>
                </div>
            </main>
            <!-- Logout button bottom right -->
            <a href="/logout" class="fixed bottom-8 right-8 bg-blue-500 hover:bg-blue-600 text-white px-8 py-3 rounded-xl font-bold shadow-xl text-base tracking-widest uppercase z-50">Logout</a>
        </div>
    </body>
</body>
</html>
