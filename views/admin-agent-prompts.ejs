<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #05070a; color: #ffffff; }
        .premium-card { background: #0c0e12; border: 1px solid rgba(255,255,255,0.05); }
        .premium-btn { background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); box-shadow: 0 4px 15px rgba(59, 130, 246, 0.4); transition: 0.3s; }
        .premium-btn:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(59, 130, 246, 0.6); }
    </style>
    <title>Agent Prompts | Admin Portal</title>
</head>
<body class="bg-[#181f2a] text-white min-h-screen">
    <header class="flex flex-col items-center justify-center p-6 max-w-6xl mx-auto">
        <img src="/logo.png" alt="Aitel Logo" class="w-24 mb-4">
        <h1 class="text-2xl font-bold mb-2">Agent: <%= agent.agent_name %></h1>
        <a href="/admin-dashboard/engineer/<%= engineer.id %>" class="bg-blue-500 text-white px-6 py-2 rounded-lg font-bold mt-2">Back</a>
    </header>
    <main class="max-w-6xl mx-auto px-6 py-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 justify-items-center">
            <% prompts.forEach(prompt => { %>
                <div class="premium-card p-8 rounded-[2rem] w-full max-w-[32rem] h-[40rem] flex flex-col items-center shadow-2xl">
                    <img src="/logo.png" alt="Aitel Logo" class="w-10 mb-2">
                    <h2 class="text-2xl font-bold mb-4"><%= prompt.title %></h2>
                    <div class="text-sm text-gray-400 mb-2">
                        Last Edit: <%= prompt.last_edit_date ? prompt.last_edit_date.toLocaleString() : 'N/A' %><br>
                        Reason: <%= prompt.last_edit_reason || 'N/A' %><br>
                        Editor: <%= prompt.last_edit_by || 'N/A' %>
                    </div>
                    <div class="mb-2 w-full h-[28rem] overflow-y-auto break-words text-sm bg-[#181f2a] rounded-xl p-4" style="word-break:break-word;">Prompt: <%= prompt.content %></div>
                    <div class="flex gap-2 mt-4">
                        <a href="/admin-dashboard/engineer/<%= engineer.id %>/agent/<%= agent.id %>/prompt/<%= prompt.id %>/view" class="text-[#2196f3] font-bold hover:underline">View</a>
                        <a href="/admin-dashboard/engineer/<%= engineer.id %>/agent/<%= agent.id %>/prompt/<%= prompt.id %>/edit" class="text-yellow-400 font-bold hover:underline">Edit</a>
                        <form action="/admin-dashboard/engineer/<%= engineer.id %>/agent/<%= agent.id %>/prompt/<%= prompt.id %>/delete" method="POST" style="display:inline">
                            <button class="text-red-400 font-bold hover:underline bg-transparent border-none">Delete</button>
                        </form>
                    </div>
                </div>
            <% }) %>
        </div>
    </main>
</body>
</html>
