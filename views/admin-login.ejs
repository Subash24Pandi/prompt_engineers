<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #05070a; color: #ffffff; }
        .premium-card { background: #0c0e12; border: 1px solid rgba(255,255,255,0.05); }
        .premium-btn { background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); box-shadow: 0 4px 15px rgba(59, 130, 246, 0.4); transition: 0.3s; }
        .premium-btn:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(59, 130, 246, 0.6); }
    </style>
    <title>Admin Login | Prompt Engineers Portal</title>
</head>
<body class="bg-gray-900 text-white min-h-screen flex items-center justify-center">
    <div class="premium-card p-8 rounded-[2rem] w-full max-w-sm text-center shadow-2xl">
        <img src="/logo.png" class="w-16 h-16 mx-auto mb-6 object-contain" onerror="this.src='https://via.placeholder.com/64?text=LOGO'">
        <h2 class="text-white text-lg font-bold mb-6 tracking-widest uppercase">Admin Login</h2>
        <form action="/admin-login" method="POST" class="space-y-4">
            <input name="username" placeholder="Admin Username" class="w-full bg-white/5 border border-white/10 p-3 rounded-xl text-white outline-none focus:border-blue-500 text-sm transition-all" required>
            <input name="password" type="password" placeholder="Password" class="w-full bg-white/5 border border-white/10 p-3 rounded-xl text-white outline-none focus:border-blue-500 text-sm transition-all" required>
            <button class="premium-btn w-full text-white py-3 rounded-xl font-bold text-xs tracking-widest uppercase">AUTHENTICATE</button>
        </form>
    </div>
</body>
</html>
